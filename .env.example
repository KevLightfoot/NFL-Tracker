# OpenAI API key (create at https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Optional model (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Required for a public personal deployment. Use a long, unique password.
# APP_PASSWORD=change-this-to-a-long-random-password

# Optional
# PORT=3000
# HOST=0.0.0.0
